{
  "name": "jettison-react",
  "private": true,
  "version": "0.1.0",
  "description": "Jettison — an enforced architecture for enterprise React applications, demonstrated by the Low Orbit Records label console. Any module can be thrown overboard and the app keeps flying; CI proves it on every push.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p fixtures/tsconfig.json",
    "lint": "oxlint --ignore-pattern 'fixtures/src/**'",
    "test": "vitest run",
    "build": "vite build"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "msw": "^2.15.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@reduxjs/toolkit": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.31.0",
    "nuqs": "^2.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
