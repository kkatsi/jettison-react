# Copy to .env.local to change how the simulated backend behaves.

# What the mock charges for a round trip, in ms. Turn it up to read the loading
# states; the console's default is fast enough to feel like a local backend.
VITE_NETWORK_MS=140

# How far the mock's read models trail its write model (ADR-002). The window the
# patch-then-verify demo lives in — below ~1000 the bug it prevents is hard to see.
VITE_READ_MODEL_LAG_MS=2500
