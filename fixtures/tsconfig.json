{
  // The fixture tree is a miniature src/: same aliases, pointed at fixtures/src, so a
  // violating import resolves (and is therefore classified) exactly as it would in the app.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": ["./src/app/*"],
      "@modules/*": ["./src/modules/*"],
      "@shared/*": ["./src/shared/*"],
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["src"]
}
